{
  "runtime_id": "EVENT-SEMANTIC-INTENT-RULES-V1",
  "status": "PHASE2_ACTIVE_CONTROLLED_TESTING",
  "purpose": "Expand live intent formation beyond request/resource language by activating reusable semantic event features, existing Human container regions and Universal rubrics. Rules create reviewable signals, not intent facts.",
  "guard": "SEMANTIC_RULE_HIT != FACT; RULE_OUTPUT != CANONICAL_PARAMETER; GENERATED_INTENT != ACTOR_KNOWLEDGE",
  "rules": [
    {"rule_id":"ESI-001","name":"PHYSICAL LIMIT ON ACTIVITY","pattern":"\\b(?:not well|unwell|sick|ill|tired|fatigue|pain|health)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"AVOID_OR_DELAY_ACTIVITY_WHILE_PHYSICALLY_LIMITED"},{"role":"TARGET","atom":"ACTIVITY_PARTICIPATION"},{"role":"CONDITION","atom":"PHYSICAL_CAPACITY_REDUCED"}],"containers":["CON-004","CON-007","CON-017","CON-063"],"rubrics":["R04","R10","R13","R31"]},
    {"rule_id":"ESI-002","name":"LOW WILLINGNESS OR DECLINE","pattern":"\\b(?:do not want|don't want|does not want|doesn't want|not interested|refuse|avoid)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"AVOID_OR_DECLINE_CURRENT_ACTION"},{"role":"TARGET","atom":"CURRENT_ACTION"},{"role":"STATE","atom":"LOW_WILLINGNESS"}],"containers":["CON-017","CON-020","CON-062","CON-063"],"rubrics":["R04","R10","R24","R31"]},
    {"rule_id":"ESI-003","name":"UNWANTED CROWD OR SOCIAL DENSITY","pattern":"\\b(?:crowd|crowded|social density|too many people)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"REDUCE_EXPOSURE_TO_UNWANTED_ENVIRONMENT"},{"role":"TARGET","atom":"ENVIRONMENTAL_EXPOSURE"},{"role":"CONDITION","atom":"HIGH_SOCIAL_DENSITY"}],"containers":["CON-014","CON-016","CON-061","CON-064"],"rubrics":["R04","R10","R13","R34"]},
    {"rule_id":"ESI-004","name":"RECENT PRIOR OCCURRENCE","pattern":"\\b(?:recently|few days ago|a few days ago|already visited|visited.{0,30}ago)\\b","intent_scope":"CONTEXT_SIGNAL","atoms":[{"role":"CONDITION","atom":"RECENT_PRIOR_OCCURRENCE"},{"role":"MODIFIER","atom":"LOWER_NOVELTY_OR_REPETITION_CONTEXT"}],"containers":["CON-033","CON-039","CON-075"],"rubrics":["R09","R39","R42"]},
    {"rule_id":"ESI-005","name":"FUTURE PLAN OR SCHEDULE","pattern":"\\b(?:will go|will be going|going on (?:the )?weekend|on the weekend|plan to|planning to|later|tomorrow|next week)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"EXECUTE_FUTURE_PLAN"},{"role":"TARGET","atom":"PLANNED_ACTIVITY"},{"role":"ORDER","atom":"FUTURE_NOT_CURRENT_EXECUTION"},{"role":"CONDITION","atom":"SCHEDULED_TIME_WINDOW"}],"containers":["CON-039","CON-046","CON-063"],"rubrics":["R09","R10","R24","R31"]},
    {"rule_id":"ESI-006","name":"COMPANION OR RELATIONSHIP CONDITION","pattern":"\\b(?:with my|with his|with her|with their)\\s+(?:girlfriend|boyfriend|partner|wife|husband|friend|family|child|children|parent|parents)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"PARTICIPATE_WITH_COMPANION"},{"role":"TARGET","atom":"RELATIONSHIP_COMPANION"},{"role":"CONDITION","atom":"COMPANION_PRESENT"}],"containers":["CON-069","CON-070","CON-071"],"rubrics":["R08","R10","R18"]},
    {"rule_id":"ESI-007","name":"SCHOOL RESISTANCE","pattern":"(?:\\b(?:does not like|doesn't like|never likes?|cry|cries|crying)\\b.{0,70}\\bschool\\b|\\bschool\\b.{0,70}\\b(?:does not like|doesn't like|cry|cries|crying)\\b)","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"AVOID_OR_RESIST_SCHOOL_ATTENDANCE"},{"role":"TARGET","atom":"SCHOOL_ATTENDANCE"},{"role":"STATE","atom":"NEGATIVE_AFFECT_OR_RESISTANCE"}],"containers":["CON-057","CON-061","CON-062","CON-063"],"rubrics":["R04","R10","R31"]},
    {"rule_id":"ESI-008","name":"SCHOOL ATTENDANCE","pattern":"\\b(?:went|go|going)\\s+to\\s+school\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"ATTEND_SCHOOL_EVENT"},{"role":"TARGET","atom":"SCHOOL_PARTICIPATION"},{"role":"METHOD","atom":"PHYSICAL_ATTENDANCE"}],"containers":["CON-017","CON-020","CON-063"],"rubrics":["R10","R24","R31"]},
    {"rule_id":"ESI-009","name":"POSITIVE AFFECT","pattern":"\\b(?:happy|very happy|pleased|excited|joy|joyful)\\b","intent_scope":"STATE_SIGNAL","atoms":[{"role":"STATE","atom":"POSITIVE_AFFECT"}],"containers":["CON-057","CON-060"],"rubrics":["R04","R30"]},
    {"rule_id":"ESI-010","name":"REPEATED CHECK OR REVERIFICATION","pattern":"(?:\\bcheck(?:s|ed|ing)?\\b.{0,100}\\b(?:again|several|multiple|repeated)\\b|\\b(?:again|several|multiple|repeated)\\b.{0,100}\\bcheck(?:s|ed|ing)?\\b)","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"VERIFY_OR_REVERIFY_STATE"},{"role":"TARGET","atom":"SAFETY_OR_CLOSURE_STATE"},{"role":"METHOD","atom":"REPEATED_CHECK"},{"role":"CONDITION","atom":"UNCERTAINTY_OR_RESPONSIBILITY"}],"containers":["CON-032","CON-044","CON-063","CON-075"],"rubrics":["R07","R22","R36","R42"]},
    {"rule_id":"ESI-011","name":"ROLE RELATIONSHIP VALUE CONFLICT","pattern":"\\b(?:duty|relatives?|teachers?|moral cost|role conflict|willingness changes?|competing duties)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"RESOLVE_COMPETING_ROLE_AND_VALUE_DEMANDS"},{"role":"TARGET","atom":"ACTION_CHOICE"},{"role":"CONDITION","atom":"ROLE_RELATIONSHIP_VALUE_CONFLICT"},{"role":"STATE","atom":"DECISION_CONFLICT"}],"containers":["CON-047","CON-063","CON-064","CON-069","CON-071","CON-072"],"rubrics":["R08","R10","R13","R24","R34"]},
    {"rule_id":"ESI-012","name":"RECOGNIZED IDENTITY ASYMMETRY","pattern":"(?:\\b(?:identity|relation|mother|biological)\\b.{0,100}\\b(?:recognized|public|institutional|hidden|private)\\b|\\b(?:recognized|public|institutional|hidden|private)\\b.{0,100}\\b(?:identity|relation|mother|biological)\\b)","intent_scope":"SYSTEM_FUNCTION","atoms":[{"role":"GOAL","atom":"ACT_ON_RECOGNIZED_IDENTITY_MODEL"},{"role":"TARGET","atom":"SOCIAL_OR_INSTITUTIONAL_IDENTITY"},{"role":"CONDITION","atom":"RECOGNITION_ASYMMETRY"},{"role":"STATE","atom":"REALITY_AND_RECOGNIZED_MODEL_DIVERGE"}],"containers":["CON-066","CON-069","CON-071","CON-072"],"rubrics":["R02","R07","R08","R43"]},
    {"rule_id":"ESI-013","name":"OBJECTIVE DEPENDENT SELECTION","pattern":"\\b(?:candidate|selection|choosing|choose|objective|seniority|popularity|campaign capacity|organization support)\\b","intent_scope":"INSTITUTIONAL_OR_ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"OPTIMIZE_SELECTION_FOR_CURRENT_OBJECTIVE"},{"role":"TARGET","atom":"CANDIDATE_CHOICE"},{"role":"METHOD","atom":"CONTEXTUAL_PARAMETER_WEIGHTING"},{"role":"CONDITION","atom":"OBJECTIVE_AND_CONSTRAINT_SPECIFIC"}],"containers":["CON-043","CON-046","CON-047","CON-069","CON-075"],"rubrics":["R10","R18","R24","R34"]},
    {"rule_id":"ESI-014","name":"SYSTEM CONDITIONAL CAPABILITY EXPRESSION","pattern":"\\b(?:athlete|capability|club|national[- ]team|performance output|system context|underlying capability)\\b","intent_scope":"FUNCTIONAL_DIRECTION","atoms":[{"role":"GOAL","atom":"EXPRESS_CAPABILITY_WITHIN_CURRENT_SYSTEM"},{"role":"TARGET","atom":"PERFORMANCE_OUTPUT"},{"role":"METHOD","atom":"ROLE_SUPPORT_AND_SYSTEM_CONFIGURATION"},{"role":"CONDITION","atom":"SYSTEM_CONTEXT"}],"containers":["CON-021","CON-047","CON-071","CON-078"],"rubrics":["R08","R10","R18","R30","R34"]},
    {"rule_id":"ESI-015","name":"OBSERVER PERCEPTUAL SIGNAL SUBSTITUTION","pattern":"(?:\\b(?:water pipe|sprays? water|falling water)\\b|\\bchildren\\b.{0,120}\\b(?:think|see|observe).{0,80}\\brain(?:ing)?\\b)","intent_scope":"ACTOR_AND_OBSERVER_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"CHANGE_OBSERVER_EVENT_MODEL"},{"role":"TARGET","atom":"OBSERVER_PERCEPTION_OR_BELIEF"},{"role":"METHOD","atom":"PERCEPTUAL_SIGNAL_SUBSTITUTION"},{"role":"CONDITION","atom":"LIMITED_OBSERVER_SOURCE_ACCESS"},{"role":"ORDER","atom":"SOURCE_SIGNAL_PRECEDES_OBSERVER_CLASSIFICATION"}],"containers":["CON-009","CON-013","CON-016","CON-023","CON-043","CON-048","CON-069","CON-075"],"rubrics":["R07","R08","R09","R10","R22","R31","R43"]},
    {"rule_id":"ESI-016","name":"OUTCOME THROUGH PERCEIVED CONDITION","pattern":"\\b(?:not going out|do not go out|don't go out|outing decision|rain condition)\\b","intent_scope":"ACTOR_HYPOTHESIS","atoms":[{"role":"GOAL","atom":"ALTER_OUTING_DECISION"},{"role":"TARGET","atom":"OUTING_BEHAVIOR"},{"role":"METHOD","atom":"USE_PERCEIVED_RAIN_CONDITION"},{"role":"CONDITION","atom":"WORLD_STATE_AND_OBSERVER_MODEL_DIFFER"}],"containers":["CON-020","CON-046","CON-047","CON-063","CON-069","CON-072"],"rubrics":["R10","R18","R23","R24","R31","R43"]},
    {"rule_id":"ESI-017","name":"ARTIFACT ORIGIN INTENT RECONSTRUCTION","pattern":"\\b(?:tablet|artifact|who ordered|who performed|for whom|expected future|surviving evidence)\\b","intent_scope":"SYSTEM_INVESTIGATION","atoms":[{"role":"GOAL","atom":"RECONSTRUCT_ARTIFACT_CREATION_INTENT"},{"role":"TARGET","atom":"ARTIFACT_ORIGIN_EVENT"},{"role":"METHOD","atom":"PARALLEL_ACTOR_BRAIN_HYPOTHESES"},{"role":"CONDITION","atom":"SURVIVING_EVIDENCE_CONSTRAINS_RECONSTRUCTION"}],"containers":["CON-043","CON-045","CON-048","CON-069","CON-075"],"rubrics":["R02","R06","R07","R22","R23","R38","R42","R43"]},
    {"rule_id":"ESI-018","name":"ARTIFACT AUTHORITY OR IDENTITY HYPOTHESIS FAMILY","pattern":"\\b(?:king|ruler|royal)\\b.{0,180}\\b(?:tablet|artifact|inscription|carving|written|write)\\b|\\b(?:tablet|artifact|inscription|carving)\\b.{0,180}\\b(?:king|ruler|royal)\\b","intent_scope":"DOMAIN_ACTOR_HYPOTHESIS_FAMILY","atoms":[{"role":"GOAL","atom":"PRESERVE_OR_PROJECT_IDENTITY_OR_AUTHORITY"},{"role":"TARGET","atom":"AUDIENCE_OR_FUTURE_OBSERVER"},{"role":"METHOD","atom":"DURABLE_EXTERNAL_REPRESENTATION"}],"containers":["CON-056","CON-066","CON-068","CON-080"],"rubrics":["R02","R08","R10","R30","R39","R43"]},
    {"rule_id":"ESI-019","name":"ARTIFACT RECORD OR COMMEMORATION HYPOTHESIS FAMILY","pattern":"\\b(?:tablet|artifact|inscription|carving)\\b","intent_scope":"DOMAIN_ACTOR_HYPOTHESIS_FAMILY","atoms":[{"role":"GOAL","atom":"RECORD_OR_COMMUNICATE_FOR_PERSISTENCE"},{"role":"TARGET","atom":"FUTURE_RETRIEVAL_OR_AUDIENCE"},{"role":"METHOD","atom":"EXTERNAL_DURABLE_RECORD"}],"containers":["CON-034","CON-056","CON-066","CON-080"],"rubrics":["R06","R10","R30","R39","R43"]}
  ]
}
