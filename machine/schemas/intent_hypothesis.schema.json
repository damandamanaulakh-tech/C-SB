{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sourceborn.local/schema/intent_hypothesis.schema.json",
  "title":"Sourceborn Live Intent Hypothesis Schema",
  "$defs":{
    "IntentSignal":{
      "type":"object",
      "required":["signal_id","sequence_id","source_kind","role","atom"],
      "properties":{
        "signal_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "source_kind":{"enum":["FEATURE","DERIVED_STRUCTURE","HUMAN_PARAMETER","HUMAN_PARAMETER_CANDIDATE","PRIOR_PATTERN","USER_ATTRIBUTION","OTHER"]},
        "source_ref":{"type":["string","null"]},
        "role":{"enum":["GOAL","TARGET","METHOD","CONDITION","ORDER","MODIFIER","CONSTRAINT","STATE"]},
        "atom":{"type":"string"},
        "source_status":{"enum":["OBSERVED_OR_REPORTED_STRUCTURE","APPROVED_PARAMETER","REVIEW_REQUIRED_PARAMETER_CANDIDATE","USER_ATTRIBUTED","INFERRED","UNKNOWN"]},
        "evidence_refs":{"type":"array","items":{"type":"string"}}
      }
    },
    "IntentHypothesisCandidate":{
      "type":"object",
      "required":[
        "intent_candidate_id","sequence_id","machine_label","machine_description","epistemic_status","novelty_status",
        "goal_atoms","target_atoms","method_atoms","condition_atoms","order_atoms","supporting_signal_ids",
        "supporting_parameter_refs","alternative_explanations","falsifiers","proof_debt","review_status","direct_action_authority"
      ],
      "properties":{
        "intent_candidate_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "machine_label":{"type":"string"},
        "machine_description":{"type":"string"},
        "epistemic_status":{"enum":["HYPOTHESIZED","USER_ATTRIBUTED","UNKNOWN"]},
        "novelty_status":{"enum":["NEW_LIVE_INTENT_CANDIDATE","MATCHES_PRIOR_INTENT_SIGNATURE","USER_ATTRIBUTED_EXISTING","UNKNOWN"]},
        "signature":{"type":"string"},
        "goal_atoms":{"type":"array","items":{"type":"string"}},
        "target_atoms":{"type":"array","items":{"type":"string"}},
        "method_atoms":{"type":"array","items":{"type":"string"}},
        "condition_atoms":{"type":"array","items":{"type":"string"}},
        "order_atoms":{"type":"array","items":{"type":"string"}},
        "modifier_atoms":{"type":"array","items":{"type":"string"}},
        "constraint_atoms":{"type":"array","items":{"type":"string"}},
        "state_atoms":{"type":"array","items":{"type":"string"}},
        "supporting_signal_ids":{"type":"array","items":{"type":"string"},"minItems":2},
        "supporting_parameter_refs":{"type":"array","items":{"type":"string"}},
        "supporting_pattern_refs":{"type":"array","items":{"type":"string"}},
        "supporting_sequence_ids":{"type":"array","items":{"type":"string"}},
        "alternative_explanations":{"type":"array","items":{"type":"string"},"minItems":1},
        "falsifiers":{"type":"array","items":{"type":"string"},"minItems":1},
        "proof_debt":{"type":"array","items":{"type":"string"},"minItems":1},
        "evidence_strength":{},
        "confidence":{},
        "depends_on_review_required_parameter_candidates":{"type":"boolean"},
        "review_status":{"enum":["NOT_REVIEWED","APPROVED","EDITED_AND_APPROVED","REJECTED","NEEDS_MORE_EVIDENCE"]},
        "approval_scope":{"type":["string","null"]},
        "direct_action_authority":{"const":false}
      }
    },
    "IntentContributionPacket":{
      "type":"object",
      "required":["contribution_id","sequence_id","candidate_ids","contribution_type"],
      "properties":{
        "contribution_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "candidate_ids":{"type":"array","items":{"type":"string"}},
        "contribution_type":{"enum":["NEW_INTENT_CANDIDATE_SIGNAL","SUPPORT_PRIOR_INTENT","MIXED_NEW_AND_PRIOR","NO_INTENT_CANDIDATE"]},
        "parameter_refs":{"type":"array","items":{"type":"string"}},
        "pattern_refs":{"type":"array","items":{"type":"string"}},
        "proof_debt_present":{"type":"boolean"}
      }
    }
  }
}
