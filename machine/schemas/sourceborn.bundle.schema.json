{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceborn.local/schema/sourceborn.bundle.schema.json",
  "title": "Sourceborn ASI Sequence Schema Bundle",
  "$defs": {
    "Sequence": {
      "type": "object",
      "required": ["sequence_id", "declared_end", "scope", "status"],
      "properties": {
        "sequence_id": {"type":"string"},
        "name": {"type":"string"},
        "declared_end": {"type":"string"},
        "scope": {"type":"object"},
        "closure_scope": {"type":"string"},
        "resolution": {"type":"string"},
        "relation_type": {"type":"string"},
        "reference_sequence_ids": {"type":"array","items":{"type":"string"}},
        "prior_reality_node_ids": {"type":"array","items":{"type":"string"}},
        "node_ids": {"type":"array","items":{"type":"string"}},
        "edge_ids": {"type":"array","items":{"type":"string"}},
        "seed_ids": {"type":"array","items":{"type":"string"}},
        "view_ids": {"type":"array","items":{"type":"string"}},
        "status": {"type":"string"},
        "closure_packet_id": {"type":["string","null"]}
      }
    },
    "Node": {
      "type":"object",
      "required":["node_id","sequence_id","exact_name","node_type"],
      "properties": {
        "node_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "exact_name":{"type":"string"},
        "exact_meaning":{"type":"string"},
        "node_type":{"type":"string"},
        "order_type":{"type":"string"},
        "followed_object_id":{"type":["string","null"]},
        "input_state":{},
        "output_state":{},
        "produced_by":{"type":["string","null"]},
        "provenance_source":{"type":["string","null"]},
        "depends_on":{"type":"array","items":{"type":"string"}},
        "relation_ids":{"type":"array","items":{"type":"string"}},
        "driver":{},
        "controller":{},
        "performer":{},
        "carrier":{},
        "trigger":{},
        "threshold":{},
        "evaluator":{},
        "recheck_condition":{},
        "rubric_activation_ids":{"type":"array","items":{"type":"string"}},
        "entity_outcome":{"type":["string","null"]},
        "unresolved_conditions":{"type":"array"}
      }
    },
    "Edge": {
      "type":"object",
      "required":["edge_id","sequence_id","source_node_id","target_node_id","order_type","threshold"],
      "properties": {
        "edge_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "source_node_id":{"type":"string"},
        "target_node_id":{"type":"string"},
        "order_type":{"type":"string"},
        "trigger":{},
        "threshold":{},
        "evaluator":{},
        "evaluation_time":{},
        "recheck_condition":{},
        "dependencies":{"type":"array","items":{"type":"string"}},
        "required_returns":{"type":"array","items":{"type":"string"}},
        "controller":{},
        "performer":{},
        "carrier":{},
        "rule_ids":{"type":"array","items":{"type":"string"}},
        "exception_contract_id":{"type":["string","null"]},
        "epistemic_status":{"type":"string"},
        "proof_depth":{}
      }
    },
    "SubSequenceContract": {
      "type":"object",
      "required":["sequence_id","requesting_sequence_id","reason","close_condition","acceptance_condition"],
      "properties": {
        "sequence_id":{"type":"string"},
        "relation_type":{"type":"string"},
        "requesting_sequence_id":{"type":"string"},
        "requesting_node_or_edge":{"type":"string"},
        "reason":{"type":"string"},
        "requested_result":{},
        "return_schema":{},
        "scope":{},
        "context_snapshot":{},
        "driver":{},
        "controller":{},
        "performer":{},
        "carrier":{},
        "activation_condition":{},
        "close_condition":{},
        "acceptance_condition":{},
        "required_or_optional":{"type":"string"},
        "epistemic_requirement":{},
        "proof_depth":{},
        "dependencies":{"type":"array"},
        "deadline_or_time_condition":{},
        "termination_policy":{}
      }
    },
    "ClosurePacket": {
      "type":"object",
      "required":["sequence_id","closure_scope","closure_status","declared_end","pass3_status"],
      "properties": {
        "sequence_id":{"type":"string"},
        "sequence_name":{"type":"string"},
        "closure_scope":{"type":"string"},
        "closure_status":{"type":"string"},
        "declared_end":{"type":"string"},
        "starting_reality":{},
        "final_reality":{},
        "result_set":{"type":"array"},
        "entity_outcomes":{"type":"array"},
        "effect_records":{"type":"array"},
        "related_sequence_ids":{"type":"array"},
        "verification_status":{},
        "trace_ids":{"type":"array"},
        "memory_ids":{"type":"array"},
        "unresolved_conditions":{"type":"array"},
        "epistemic_summary":{},
        "next_sequence_seeds":{"type":"array"},
        "prior_sequence_references":{"type":"array"},
        "pass3_status":{"type":"string"}
      }
    },
    "ViewState": {
      "type":"object",
      "required":["view_id","actor_or_system_id","sequence_id"],
      "properties": {
        "view_id":{"type":"string"},
        "actor_or_system_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "time_or_state_ref":{},
        "known":{"type":"array"},
        "believed":{"type":"array"},
        "inferred":{"type":"array"},
        "unknown":{"type":"array"},
        "false_beliefs":{"type":"array"},
        "hidden_from_actor":{"type":"array"},
        "source_refs":{"type":"array"},
        "confidence":{"type":"array"}
      }
    },
    "Seed": {
      "type":"object",
      "required":["seed_id","seed_type","current_status"],
      "properties": {
        "seed_id":{"type":"string"},
        "source_sequence_id":{"type":["string","null"]},
        "source_closure_packet_id":{"type":["string","null"]},
        "seed_type":{"type":"string"},
        "seed_content":{},
        "created_at":{},
        "persistence_condition":{},
        "carrier_bound":{"type":"boolean"},
        "possible_carrier_types":{"type":"array"},
        "activation_trigger":{},
        "activation_threshold":{},
        "current_status":{"type":"string"},
        "resulting_sequence_ids":{"type":"array"}
      }
    },
    "RubricBinding": {
      "type":"object",
      "required":["binding_id","domain_type","native_source_id","native_name"],
      "properties": {
        "binding_id":{"type":"string"},
        "domain_type":{"type":"string"},
        "native_source_id":{"type":"string"},
        "native_parent_ids":{"type":"array"},
        "native_name":{"type":"string"},
        "native_definition":{"type":"string"},
        "primary_sequence_roles":{"type":"array"},
        "secondary_sequence_roles":{"type":"array"},
        "allowed_order_types":{"type":"array"},
        "activation_conditions":{"type":"array"},
        "controller_affinity":{"type":"array"},
        "performer_affinity":{"type":"array"},
        "carrier_affinity":{"type":"array"},
        "read_channels":{"type":"array"},
        "writeback_channels":{"type":"array"},
        "combination_group_ids":{"type":"array"},
        "memory_effects":{"type":"array"},
        "source_ref":{},
        "epistemic_status":{"type":"string"}
      }
    },
    "SentenceIntakePacket":{"$ref":"micro_sequence_learning.schema.json#/$defs/SentenceIntakePacket"},
    "MicroUnit":{"$ref":"micro_sequence_learning.schema.json#/$defs/MicroUnit"},
    "RubricActivationPacket":{"$ref":"micro_sequence_learning.schema.json#/$defs/RubricActivationPacket"},
    "InterpretationCandidate":{"$ref":"micro_sequence_learning.schema.json#/$defs/InterpretationCandidate"},
    "PatternContributionPacket":{"$ref":"micro_sequence_learning.schema.json#/$defs/PatternContributionPacket"},
    "PatternCandidate":{"$ref":"micro_sequence_learning.schema.json#/$defs/PatternCandidate"},
    "ReviewableRubricView":{"$ref":"micro_sequence_learning.schema.json#/$defs/ReviewableRubricView"},
    "RubricEditDecision":{"$ref":"micro_sequence_learning.schema.json#/$defs/RubricEditDecision"},
    "LearningWritebackPacket":{"$ref":"micro_sequence_learning.schema.json#/$defs/LearningWritebackPacket"}
  }
}
