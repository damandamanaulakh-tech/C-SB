{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceborn.local/schema/micro_sequence_learning.schema.json",
  "title": "Sourceborn Micro-Sequence Learning Schema",
  "$defs": {
    "SentenceIntakePacket": {
      "type":"object",
      "required":["intake_id","sequence_id","raw_text","source_type","declared_end","scope"],
      "properties":{
        "intake_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "raw_text":{"type":"string"},
        "source_type":{"enum":["USER_UTTERANCE","WORLD_OBSERVATION","DOCUMENT_SENTENCE","SYSTEM_RESPONSE","USER_CORRECTION","OTHER"]},
        "speaker_or_source_id":{"type":["string","null"]},
        "time_ref":{},
        "context_ref_ids":{"type":"array","items":{"type":"string"}},
        "declared_end":{},
        "scope":{},
        "closure_scope":{}
      }
    },
    "MicroUnit": {
      "type":"object",
      "required":["micro_unit_id","sequence_id","source_span","unit_type","epistemic_status"],
      "properties":{
        "micro_unit_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "parent_micro_unit_id":{"type":["string","null"]},
        "source_span":{},
        "exact_text":{"type":"string"},
        "unit_type":{"enum":["CLAUSE","PHRASE","ENTITY","REFERENCE","ACTION","EVENT","OMISSION","STATE","PROPERTY","VALUE","RELATION","ORDER","NEGATION","MODALITY","QUALIFIER","EXPECTATION","DIFFERENCE","EVIDENCE","OTHER"]},
        "linked_object_ids":{"type":"array","items":{"type":"string"}},
        "relation_ids":{"type":"array","items":{"type":"string"}},
        "order_types":{"type":"array","items":{"type":"string"}},
        "view_state_refs":{"type":"array","items":{"type":"string"}},
        "epistemic_status":{"enum":["OBSERVED","REPORTED","INFERRED","HYPOTHESIZED","UNKNOWN","CONTRADICTED","USER_ATTRIBUTED"]},
        "confidence":{}
      }
    },
    "RubricActivationPacket": {
      "type":"object",
      "required":["activation_id","sequence_id","micro_unit_ids","rubric_path","activation_status"],
      "properties":{
        "activation_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "micro_unit_ids":{"type":"array","items":{"type":"string"}},
        "rubric_path":{"type":"array","items":{"type":"string"},"minItems":1},
        "domain":{"enum":["HUMAN","AI","ASI","WISDOM","UNIVERSAL_SEQUENCE","SOURCEBORN_RUNTIME","OTHER"]},
        "activation_evidence_refs":{"type":"array","items":{"type":"string"}},
        "activation_status":{"enum":["CANDIDATE","ACTIVE","REJECTED","UNKNOWN"]},
        "weight_or_relevance":{},
        "engine_candidate_ids":{"type":"array","items":{"type":"string"}},
        "asi_node_candidate_ids":{"type":"array","items":{"type":"string"}}
      }
    },
    "InterpretationCandidate": {
      "type":"object",
      "required":["interpretation_id","sequence_id","claim","claim_type","epistemic_status"],
      "properties":{
        "interpretation_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "claim":{"type":"string"},
        "claim_type":{"enum":["MEANING","EMOTION","FEELING","INTENT","MOTIVE","EXPECTATION","VALUE","BOUNDARY","RELATIONSHIP_PATTERN","CAUSAL_HYPOTHESIS","OTHER"]},
        "supporting_micro_unit_ids":{"type":"array","items":{"type":"string"}},
        "supporting_sequence_ids":{"type":"array","items":{"type":"string"}},
        "contradicting_sequence_ids":{"type":"array","items":{"type":"string"}},
        "alternative_interpretation_ids":{"type":"array","items":{"type":"string"}},
        "epistemic_status":{"enum":["INFERRED","HYPOTHESIZED","USER_ATTRIBUTED","OBSERVED","UNKNOWN"]},
        "confidence":{},
        "direct_action_authority":{"const":false}
      }
    },
    "PatternContributionPacket": {
      "type":"object",
      "required":["contribution_id","sequence_id","contribution_type","evidence_refs"],
      "properties":{
        "contribution_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "target_pattern_id":{"type":["string","null"]},
        "contribution_type":{"enum":["ACTIVATE_EXISTING","SUPPORT_EXISTING","CONTRADICT_EXISTING","WEAKEN_EXISTING","NEW_CANDIDATE_SIGNAL","NO_MEANINGFUL_PATTERN"]},
        "evidence_refs":{"type":"array","items":{"type":"string"}},
        "difference_refs":{"type":"array","items":{"type":"string"}},
        "relation_refs":{"type":"array","items":{"type":"string"}},
        "context_scope":{},
        "repetition_count":{},
        "counterfactual_weight":{},
        "candidate_creation_requested":{"type":"boolean"}
      }
    },
    "PatternCandidate": {
      "type":"object",
      "required":["pattern_candidate_id","name","status","supporting_sequence_ids","alternative_interpretations","intent_status","approval_status"],
      "properties":{
        "pattern_candidate_id":{"type":"string"},
        "name":{"type":"string"},
        "machine_description":{"type":"string"},
        "status":{"enum":["DRAFT","REVIEW_REQUIRED","REJECTED","APPROVED_VERSIONED","SUPERSEDED"]},
        "supporting_sequence_ids":{"type":"array","items":{"type":"string"}},
        "contradicting_sequence_ids":{"type":"array","items":{"type":"string"}},
        "parameter_refs":{"type":"array","items":{"type":"string"}},
        "rubric_refs":{"type":"array","items":{"type":"string"}},
        "relation_signature":{},
        "order_signature":{},
        "context_bounds":{},
        "alternative_interpretations":{"type":"array"},
        "intent_status":{"enum":["OBSERVED","USER_ATTRIBUTED","INFERRED","UNKNOWN","NOT_APPLICABLE"]},
        "confidence":{},
        "approval_status":{"enum":["NOT_REVIEWED","APPROVED","EDITED_AND_APPROVED","REJECTED","NEEDS_MORE_EVIDENCE"]},
        "approval_scope":{"type":["string","null"]},
        "approved_pattern_id":{"type":["string","null"]}
      }
    },
    "ReviewableRubricView": {
      "type":"object",
      "required":["review_id","sequence_id","machine_proposal","editable_fields","source_proposal_immutable"],
      "properties":{
        "review_id":{"type":"string"},
        "sequence_id":{"type":"string"},
        "machine_proposal":{},
        "activated_rubric_paths":{"type":"array"},
        "prior_sequence_refs":{"type":"array"},
        "engine_trace_ids":{"type":"array"},
        "node_trace_ids":{"type":"array"},
        "unknowns":{"type":"array"},
        "editable_fields":{
          "type":"object",
          "properties":{
            "interpretation":{},
            "feeling":{},
            "emotion":{},
            "meaning":{},
            "intent_attribution":{},
            "motive_attribution":{},
            "boundary":{},
            "rule_or_principle":{},
            "pattern_name":{},
            "applies_when":{},
            "does_not_apply_when":{},
            "approval_scope":{}
          }
        },
        "source_proposal_immutable":{"const":true}
      }
    },
    "RubricEditDecision": {
      "type":"object",
      "required":["decision_id","review_id","editor_id","decision","scope"],
      "properties":{
        "decision_id":{"type":"string"},
        "review_id":{"type":"string"},
        "editor_id":{"type":"string"},
        "decision":{"enum":["APPROVE_AS_IS","EDIT_AND_APPROVE","REJECT","KEEP_OCCURRENCE_ONLY","NEEDS_MORE_EVIDENCE","CREATE_NEW_PATTERN_CANDIDATE","PROPOSE_RUBRIC_CHANGE"]},
        "scope":{"enum":["OCCURRENCE_ONLY","PERSONAL_PATTERN","RELATIONSHIP_SPECIFIC_PATTERN","DOMAIN_PATTERN","GENERAL_PATTERN_CANDIDATE","RUBRIC_CHANGE_CANDIDATE"]},
        "edits":{},
        "reason":{},
        "time_ref":{}
      }
    },
    "LearningWritebackPacket": {
      "type":"object",
      "required":["writeback_id","writeback_sequence_id","source_review_id","source_decision_id","target_store","version_action"],
      "properties":{
        "writeback_id":{"type":"string"},
        "writeback_sequence_id":{"type":"string"},
        "source_review_id":{"type":"string"},
        "source_decision_id":{"type":"string"},
        "prior_closed_sequence_refs":{"type":"array","items":{"type":"string"}},
        "target_store":{"enum":["OCCURRENCE_MEMORY","PERSONAL_PATTERN_REGISTRY","RELATIONSHIP_PATTERN_REGISTRY","DOMAIN_PATTERN_REGISTRY","GENERAL_PATTERN_CANDIDATES","RUBRIC_CHANGE_CANDIDATES"]},
        "version_action":{"enum":["CREATE","SUPERSEDE_WITH_NEW_VERSION","ADD_EVIDENCE","ADD_COUNTER_EVIDENCE","CHANGE_APPLICABILITY","NO_WRITEBACK"]},
        "new_object_id":{"type":["string","null"]},
        "supersedes_object_id":{"type":["string","null"]},
        "provenance_refs":{"type":"array"},
        "closure_status":{}
      }
    }
  }
}