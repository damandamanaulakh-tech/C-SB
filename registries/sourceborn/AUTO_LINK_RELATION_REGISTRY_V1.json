{
  "registry_id": "SOURCEBORN-AUTO-LINK-RELATION-REGISTRY-V1",
  "version": "1.0.0",
  "status": "PHASE2_ACTIVE_AUTO_LINK_REGISTRY",
  "runtime_stage": "RT-16",
  "memory_schema_ref": "machine/schemas/memory_object.schema.json#/$defs/MemoryLink",
  "relation_law": [
    "AUTO_LINK creates typed candidate edges; it does not merge object identity.",
    "A link may be ACTIVE only when its rule-specific threshold is met.",
    "Shared wording alone is insufficient for causal, identity, provenance or intent links.",
    "Shared source lineage must be tracked so copies do not become independent corroboration.",
    "Closed source and closed Sequence objects are never mutated by linking; links are additive external graph records.",
    "UNKNOWN or GAP is preferred over forced linking."
  ],
  "relation_types": [
    {"relation_type":"SOURCE_OF","category":"PROVENANCE","auto_candidate":true,"active_threshold":"exact_source_ref_or_verified_lineage","requires":["source_ref"],"forbids":["name_similarity_only"]},
    {"relation_type":"DERIVED_FROM","category":"PROVENANCE","auto_candidate":true,"active_threshold":"explicit_lineage_step_and_source_ref","requires":["lineage"],"forbids":["unlogged_transform"]},
    {"relation_type":"MEMORY_OF","category":"MEMORY","auto_candidate":true,"active_threshold":"memory_owner_or_payload_ref_matches_object","requires":["memory_ref"],"forbids":[]},
    {"relation_type":"EVENT_OF","category":"EVENT","auto_candidate":true,"active_threshold":"event_record_explicitly_refs_object_or_sequence","requires":["event_ref"],"forbids":["topic_similarity_only"]},
    {"relation_type":"PART_OF_EVENT","category":"EVENT","auto_candidate":true,"active_threshold":"bounded_event_parent_child_contract","requires":["parent_event_ref","child_event_ref"],"forbids":["chronological_nearness_only"]},
    {"relation_type":"SEQUENCE_OF","category":"SEQUENCE","auto_candidate":true,"active_threshold":"sequence_record_explicit_scope_relation","requires":["sequence_ref"],"forbids":[]},
    {"relation_type":"SUBSEQUENCE_OF","category":"SEQUENCE","auto_candidate":true,"active_threshold":"SubSequence_contract_ref_exists","requires":["subsequence_contract"],"forbids":["similar_goal_only"]},
    {"relation_type":"PRECEDES","category":"ORDER","auto_candidate":true,"active_threshold":"typed_order_evidence_supports_before_relation","requires":["order_type"],"forbids":["visual_left_to_right_assumption_without_reading_direction"]},
    {"relation_type":"FOLLOWS","category":"ORDER","auto_candidate":true,"active_threshold":"typed_order_evidence_supports_after_relation","requires":["order_type"],"forbids":[]},
    {"relation_type":"DEPENDS_ON","category":"DEPENDENCY","auto_candidate":true,"active_threshold":"target_cannot_legally_fire_without_predecessor_or_contract","requires":["dependency_reason"],"forbids":["cooccurrence_only"]},
    {"relation_type":"PRODUCED_BY","category":"CAUSAL","auto_candidate":true,"active_threshold":"producer_path_or_source_evidence","requires":["producer_ref"],"forbids":["mere_temporal_precedence"]},
    {"relation_type":"RESULT_OF","category":"CAUSAL","auto_candidate":true,"active_threshold":"result_trace_to_transition_or_event","requires":["result_trace"],"forbids":["correlation_only"]},
    {"relation_type":"FUTURE_OF","category":"TEMPORAL_FUTURE","auto_candidate":true,"active_threshold":"future_state_or_seed_explicitly_refs_prior_object","requires":["prior_ref"],"forbids":["wishful_association"]},
    {"relation_type":"ACTOR_OF","category":"ACTOR_ROLE","auto_candidate":true,"active_threshold":"actor_role_record_explicitly_links_actor_and_event","requires":["actor_ref","event_ref","role_type"],"forbids":["subject_equals_controller_assumption"]},
    {"relation_type":"REQUESTED_BY","category":"ACTOR_ROLE","auto_candidate":true,"active_threshold":"requester_evidence_or_hypothesis_status_attached","requires":["requester_ref"],"forbids":["performer_equals_requester_assumption"]},
    {"relation_type":"CONTROLLED_BY","category":"ACTOR_ROLE","auto_candidate":true,"active_threshold":"controller_record_or_governance_contract","requires":["controller_ref"],"forbids":["authority_inferred_from_visibility_only"]},
    {"relation_type":"PERFORMED_BY","category":"ACTOR_ROLE","auto_candidate":true,"active_threshold":"performance_or_production_evidence","requires":["performer_ref"],"forbids":["subject_equals_performer_assumption"]},
    {"relation_type":"BENEFITS","category":"ACTOR_ROLE","auto_candidate":true,"active_threshold":"beneficiary_or_future_state_model_supports_relation","requires":["beneficiary_ref"],"forbids":[]},
    {"relation_type":"AUDIENCE_OF","category":"ACTOR_ROLE","auto_candidate":true,"active_threshold":"audience_context_or_design_evidence","requires":["audience_ref"],"forbids":["public_audience_assumed_from_survival"]},
    {"relation_type":"SUPPORTS","category":"EVIDENCE","auto_candidate":true,"active_threshold":"evidence_is_relevant_and_independence_group_recorded","requires":["evidence_ref","source_independence_group"],"forbids":["duplicate_source_count_as_independent_support"]},
    {"relation_type":"CONTRADICTS","category":"EVIDENCE","auto_candidate":true,"active_threshold":"material_incompatibility_or_counterevidence_exists","requires":["contradiction_reason"],"forbids":["mere_difference_in_wording"]},
    {"relation_type":"COUNTEREXAMPLE_TO","category":"FALSIFIER","auto_candidate":true,"active_threshold":"counter_case_hits_claim_scope","requires":["counter_case_ref"],"forbids":[]},
    {"relation_type":"FALSIFIES","category":"FALSIFIER","auto_candidate":true,"active_threshold":"declared_falsifier_condition_met","requires":["falsifier_ref","test_result"],"forbids":["low_score_only"]},
    {"relation_type":"SIMILAR_TO","category":"SIMILARITY","auto_candidate":true,"active_threshold":"similarity_features_exceed_domain_threshold","requires":["feature_basis"],"forbids":["identity_merge"]},
    {"relation_type":"SAME_AS","category":"IDENTITY","auto_candidate":false,"active_threshold":"identity_proof_or_authoritative_mapping_required","requires":["identity_evidence"],"forbids":["automatic_promotion_from_similarity"]},
    {"relation_type":"SPECIALIZES","category":"ABSTRACTION","auto_candidate":true,"active_threshold":"child_scope_is_strict_subset_and_definition_consistent","requires":["scope_comparison"],"forbids":[]},
    {"relation_type":"GENERALIZES","category":"ABSTRACTION","auto_candidate":true,"active_threshold":"parent_pattern_covers_multiple_instances_and_countercases_checked","requires":["instance_refs","counter_case_refs"],"forbids":["single_case_generalization"]},
    {"relation_type":"INSTANCE_OF","category":"ABSTRACTION","auto_candidate":true,"active_threshold":"object_satisfies_pattern_or_type_contract","requires":["type_or_pattern_ref"],"forbids":[]},
    {"relation_type":"COMBINES_WITH","category":"COMBINATION","auto_candidate":true,"active_threshold":"combination_record_contains_both_components","requires":["combination_id"],"forbids":["claim_of_new_primitive"]},
    {"relation_type":"ACTIVATES","category":"RUNTIME","auto_candidate":true,"active_threshold":"activation_record_or_runtime_trace_exists","requires":["activation_ref"],"forbids":["potential_affinity_only"]},
    {"relation_type":"READS_MEMORY","category":"RUNTIME","auto_candidate":true,"active_threshold":"node_brain_binding_allows_channel","requires":["node_ref","memory_type"],"forbids":[]},
    {"relation_type":"WRITES_MEMORY","category":"RUNTIME","auto_candidate":true,"active_threshold":"node_brain_binding_and_write_authority_allow_channel","requires":["node_ref","memory_type","write_authority"],"forbids":["unauthorized_canonical_write"]},
    {"relation_type":"ROUTED_TO_NODE","category":"RUNTIME","auto_candidate":true,"active_threshold":"runtime_stage_binding_selects_node","requires":["stage_id","node_ref"],"forbids":[]},
    {"relation_type":"REPAIRED_BY","category":"REPAIR","auto_candidate":true,"active_threshold":"repair_SubSequence_return_accepted","requires":["repair_sequence_ref"],"forbids":["in_place_retry_hidden_as_repair"]},
    {"relation_type":"RETESTED_BY","category":"REPAIR","auto_candidate":true,"active_threshold":"retest_SubSequence_terminal_and_return_accepted","requires":["retest_sequence_ref"],"forbids":["repair_equals_retest"]},
    {"relation_type":"SUPERSEDES","category":"VERSION","auto_candidate":true,"active_threshold":"new_version_explicitly_declares_supersession","requires":["old_ref","new_ref"],"forbids":["deleting_old_source"]},
    {"relation_type":"COMPRESSED_FROM","category":"MEMORY","auto_candidate":true,"active_threshold":"compression_lineage_preserved_and_losslessness_flags_recorded","requires":["source_memory_refs"],"forbids":["source_deletion"]},
    {"relation_type":"INDEXES","category":"MEMORY","auto_candidate":true,"active_threshold":"global_index_entry_points_to_existing_object","requires":["indexed_ref"],"forbids":["index_as_authoritative_copy"]},
    {"relation_type":"PATTERN_CONTRIBUTES_TO","category":"LEARNING","auto_candidate":true,"active_threshold":"pattern_contribution_packet_refs_candidate","requires":["pattern_contribution_ref","pattern_ref"],"forbids":["automatic_pattern_promotion"]},
    {"relation_type":"SEED_FOR","category":"LEARNING","auto_candidate":true,"active_threshold":"seed_registry_ref_and_activation_contract_exist","requires":["seed_ref"],"forbids":["seed_equals_open_sequence"]}
  ],
  "auto_link_pipeline": [
    "collect_new_persistent_object_refs",
    "generate_retrieval_keys",
    "find_candidate_targets_by_source_point_zero_event_actor_role_intent_future_state_relation_path_pattern_contradiction_evidence_sequence",
    "deduplicate_same_source_lineage",
    "evaluate_relation_specific_requirements",
    "assign_CANDIDATE_or_ACTIVE_status",
    "reject_forbidden_identity_or_causality_shortcuts",
    "write_relation_memory",
    "index_link_in_global_memory_index",
    "schedule_recheck_for_open_candidate_links",
    "record_orphan_if_no_legal_link_exists"
  ],
  "never_auto_merge_classes": [
    "ACTOR_IDENTITY",
    "HISTORICAL_ENTITY_IDENTITY",
    "SOURCE_IDENTITY",
    "INTENT_IDENTITY",
    "PATTERN_IDENTITY",
    "PARAMETER_IDENTITY",
    "CONTRADICTORY_HYPOTHESES"
  ],
  "candidate_link_recheck_triggers": [
    "NEW_INDEPENDENT_EVIDENCE",
    "NEW_SOURCE_PROVENANCE",
    "NEW_IDENTITY_MAPPING",
    "NEW_COUNTER_CASE",
    "NEW_SEQUENCE_RETURN",
    "NEW_PATTERN_PROMOTION",
    "SOURCE_CORRECTION_OR_VERSION"
  ]
}
